rules_version = '2';

// Reading history is account-scoped: only the signed-in owner of a uid may
// read or write their own `users/{uid}/readingHistory/{recordId}` documents
// (and their own `users/{uid}` profile doc, if one is ever added). Everything
// else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /readingHistory/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
